# MODELO DO ARQUIVO DE CHAVES
#
# Copie este arquivo para `.env` na MESMA PASTA em que ele esta, ou seja, na
# raiz do repositorio, ao lado do chatbot.py:
#
#     rag-vaar-nacional/.env
#
#     cp .env.example .env           (Linux, macOS, Git Bash)
#     Copy-Item .env.example .env    (Windows PowerShell)
#
# Depois abra o .env e preencha os valores. Sem aspas, sem espaco em volta do
# "=", cada chave em uma linha so.
#
# O .env esta no .gitignore. NUNCA comite a chave: uma vez no historico do
# Git, ela vaza mesmo que voce apague o arquivo depois.
#
# O passo a passo completo esta na secao 11 do README.

# ── Qdrant Cloud ──────────────────────────────────────────────────────────
QDRANT_URL=https://SEU-CLUSTER.sa-east-1-0.aws.cloud.qdrant.io
QDRANT_API_KEY=

# ── Modelo de embedding ───────────────────────────────────────────────────
# Trocar o modelo exige REGERAR todos os vetores: vetores de modelos
# diferentes nao sao comparaveis entre si.
EMBEDDING_MODEL=Qwen/Qwen3-Embedding-0.6B

# ── LLM da etapa de geracao ───────────────────────────────────────────────
# Escolha UM provedor. O chatbot le estas variaveis para pre-preencher a
# barra lateral; nada impede de digitar la direto.
#   anthropic | openai | groq | gemini | ollama | outro
LLM_PROVEDOR=groq
LLM_API_KEY=
LLM_MODELO=openai/gpt-oss-120b
# So para "outro": base_url terminada em /v1
LLM_BASE_URL=

# Compatibilidade: se so ANTHROPIC_API_KEY estiver definida, o chatbot usa
# a Anthropic sem precisar das variaveis acima.
ANTHROPIC_API_KEY=

# ── Modo de busca inicial ─────────────────────────────────────────────────
# hibrida | esparsa | densa. Em servidor com pouca RAM use "esparsa": ela nao
# carrega o Qwen, que sozinho ocupa 1,7 GB. Ver a secao 14 do README.
MODO_BUSCA_PADRAO=hibrida
